# AWS credentials
AWS_PROFILE=bedrock-triage
AWS_REGION=us-east-1

# Bedrock model ID — copy from Bedrock console > Models > your Claude model
# Example (do not hardcode): anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=YOUR_MODEL_ID_HERE

# Langfuse observability
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://your-langfuse-instance.com
LANGFUSE_ENABLED=true

# Cost/latency alert thresholds (used by scripts/check_costs.py)
COST_DAILY_MAX=100.00
LATENCY_P95_MS=30000

# Token budget per run (input + output tokens)
MAX_TOKENS_PER_RUN=50000

# MCP tool server. stdio is the local default. For streamable HTTP, start
# `MCP_TRANSPORT=streamable-http python -m mcp_server.server` and set:
# MCP_TRANSPORT=streamable-http
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TRANSPORT=stdio